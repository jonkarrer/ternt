{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tokidoki",
  "version": "0.1.0",
  "identifier": "com.jokar.tokidoki",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Tokidoki",
        "width": 980,
        "height": 720,
        "minWidth": 560,
        "minHeight": 420,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 22 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "14.0"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGMjE2MTk4MEREMThFNUEKUldSYWp0RU5tR0VoajhSVStFRDNQOXcvaUdCUFZqUFNYMFg5K0RuelR0L0tZUnRncFN4SGhsNUUK",
      "endpoints": ["https://github.com/jonkarrer/tokidoki-dist/releases/latest/download/latest.json"]
    }
  }
}
