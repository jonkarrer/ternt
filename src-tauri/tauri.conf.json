{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ternt",
  "version": "0.1.0",
  "identifier": "com.jokar.ternt",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "14.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3RDZENDBDQkM5QTlDMDAKUldRQW5KcThETlRXdHhwaGNkUndLdlZzZWR2bWVFWWJtUjY5MlFGWTVML1ZYa1E4b2dzR2tUWjAK",
      "endpoints": ["https://github.com/jonkarrer/ternt/releases/latest/download/latest.json"]
    }
  }
}
